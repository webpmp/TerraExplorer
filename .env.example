# Copy this file to .env.local and add your API keys.
# Do not commit .env.local. It is ignored by git.

# -----------------------------------------------------------------------------
# 1. AI PROVIDER (REQUIRED - one of two)
#    - Recommended: LM Studio (local, free, runs on machine at http://localhost:1234/v1). No key needed.
#    - Fallback: Google Gemini API key. Powers location descriptions, notable facts, and routes.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# 2. MAP PROVIDER (REQUIRED)
#    - Carto API key: Powers street-level and vector map tiles in Earth view.
#    - Get a key at https://carto.com/developers/basemap-styles/
# -----------------------------------------------------------------------------
VITE_CARTO_API_KEY=""

# -----------------------------------------------------------------------------
# 3. NEWS PROVIDER (OPTIONAL)
#    - Configure one of the following to show contextual local news in the info panel.
# -----------------------------------------------------------------------------
VITE_NYT_API_KEY=""
VITE_NEWS_API_KEY=""
VITE_NEWS_DATA_API_KEY=""
